{
    // Cross-compilation tasks for building CrashDebugHelper on Linux.
    // See "Building on Linux (cross-compiling to Windows)" in README.md for setup
    // (Nix, the xwin fetch, and CMakeUserPresets.json) before running these.
    //
    // Every task runs inside the ZHMModSDK Nix dev shell. The shell's hook derives
    // XWIN_SPLAT_DIR and VCPKG_ROOT from the working directory, so "cwd" must be the
    // SDK checkout; each task then cd's back into this workspace. The default
    // "${workspaceFolder}/../../ZHMModSDK" assumes the SDK sits alongside the Mods
    // folder -- adjust it if your layout differs.
    //
    // "nix" is resolved from PATH via /etc/profile.d/nix.sh, which login shells source.
    // If VS Code was started from a desktop launcher and cannot find it, replace the
    // "command" values with "/nix/var/nix/profiles/default/bin/nix".
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}/../../ZHMModSDK"
    },
    "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared",
        "clear": true
    },
    "tasks": [
        {
            "label": "cross: build + install",
            "detail": "Build the mod and copy it (and the local ZHMModSDK.dll) into the game folder",
            "type": "process",
            "command": "nix",
            "args": [
                "develop",
                "--command",
                "bash",
                "-c",
                "cd '${workspaceFolder}' && cmake --build _build/x64-Release-Cross-Install --parallel && cmake --install _build/x64-Release-Cross-Install"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*)\\((\\d+),(\\d+)\\):\\s+(error|warning|note):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "cross: build",
            "detail": "Build the mod only, without touching the game folder",
            "type": "process",
            "command": "nix",
            "args": [
                "develop",
                "--command",
                "bash",
                "-c",
                "cd '${workspaceFolder}' && cmake --build _build/x64-Release-Cross-Install --parallel"
            ],
            "group": "build",
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*)\\((\\d+),(\\d+)\\):\\s+(error|warning|note):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "cross: configure",
            "detail": "Re-run CMake configure (also rebuilds and installs the SDK). Needed after editing CMakeLists.txt or the presets.",
            "type": "process",
            "command": "nix",
            "args": [
                "develop",
                "--command",
                "bash",
                "-c",
                "cd '${workspaceFolder}' && cmake --preset x64-Release-Cross-Install ."
            ],
            "problemMatcher": []
        },
        {
            "label": "cross: clean",
            "detail": "Delete the cross build directory (keeps vcpkg's binary cache)",
            "type": "process",
            "command": "bash",
            "args": [
                "-c",
                "rm -rf '${workspaceFolder}/_build/x64-Release-Cross-Install'"
            ],
            "problemMatcher": []
        }
    ]
}
